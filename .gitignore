# 科研自动化助手 — .gitignore

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
venv/
.venv/
env/

# --- 配置文件（含密钥） ---
.env
config/api_keys.json
*.local.yaml

# --- 运行时数据 ---
data/pdf/*
!data/pdf/.gitkeep
data/markdown/*
!data/markdown/.gitkeep
data/vector_db/*
!data/vector_db/.gitkeep
data/paper.db
data/paper.db-wal
data/paper.db-shm
data/logs/*
!data/logs/.gitkeep
data/search_results/*
!data/search_results/.gitkeep
data/profiles/*
!data/profiles/.gitkeep

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- 测试 ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- 其他 ---
*.tmp
*.bak

# ===== 本地敏感配置 =====
.env
*.env
config/api_keys.json
config/*.local.json
config/*.secret.json

# ===== Python 缓存与虚拟环境 =====
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ===== 运行日志 =====
*.log
data/logs/

# ===== 数据库与运行产物 =====
data/*.db
data/*.sqlite
data/*.sqlite3
data/paper.db

# ===== 文献与解析结果，不提交到 Git =====
data/pdf/
data/markdown/
data/vector_db/
data/profiles/
data/search_results/

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== AI 助手本地配置（不提交） =====
.claude/settings.local.json
.claude/*.local.json
.claude/**/*.local.md

# ===== 上传暂存目录（不提交） =====
data/temp/

# ===== 合并冲突残留 =====
*.orig
*.rej
