# ============================================================================
# 科研自动化助手 — 环境变量模板
# 复制此文件为 .env 并填入实际值
# 所有变量均有前缀 PAPER_ASSIST_
# ============================================================================

# --- 数据库 ---
# SQLite 数据库路径（覆盖 config/default.yaml）
# PAPER_ASSIST_DATABASE_PATH=data/paper.db

# --- DeepSeek LLM ---
# DeepSeek API Key（必填）
PAPER_ASSIST_LLM_API_KEY=your-deepseek-api-key-here
# DeepSeek API Base URL（默认 https://api.deepseek.com/v1）
# PAPER_ASSIST_LLM_API_BASE=https://api.deepseek.com/v1

# --- 嵌入模型（OpenAI 兼容 API）---
# 如果使用 OpenAI 嵌入模型
# PAPER_ASSIST_EMBEDDING_API_KEY=your-openai-api-key-here
# PAPER_ASSIST_EMBEDDING_API_BASE=https://api.openai.com/v1

# --- OpenAlex API Key（可选，推荐）---
# PAPER_ASSIST_OPENALEX_API_KEY=your-openalex-api-key-here

# --- Crossref mailto（推荐，纳入 polite pool）---
# PAPER_ASSIST_CROSSREF_MAILTO=your-email@institution.edu

# --- PubMed / NCBI API Key（可选，提高速率 3→10 rps）---
# PAPER_ASSIST_NCBI_API_KEY=your-ncbi-api-key-here

# --- Semantic Scholar API Key（可选）---
# PAPER_ASSIST_SEMANTIC_SCHOLAR_API_KEY=your-s2-api-key-here

# --- Unpaywall email（推荐配置，否则警告）---
# PAPER_ASSIST_UNPAYWALL_EMAIL=your-email@institution.edu

# --- 机构邮箱（用于 User-Agent）---
PAPER_ASSIST_CONTACT_EMAIL=your-email@institution.edu

# --- 日志级别 ---
# PAPER_ASSIST_LOGGING_LEVEL=INFO

# --- 开发模式 ---
# PAPER_ASSIST_APP_DEBUG=false
